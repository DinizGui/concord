# Banco MySQL (Prisma). Crie o banco vazio e rode: npm run db:push
DATABASE_URL="mysql://usuario:senha@host:3306/concord"

# Protege /api/v1/internal/maintenance (cron da Vercel manda "Authorization: Bearer <valor>")
CRON_SECRET=""

# Endereço público do app (links dos e-mails e dos webhooks). Sem ele, usa o domínio da requisição.
# APP_URL="https://concord.exemplo.com"

# E-mail (confirmação de conta e troca de senha) via Resend. Sem a chave, o link vai pro log do servidor.
# RESEND_API_KEY=""
# MAIL_FROM="Concord <nao-responda@seudominio.com>"

# Anexos e emojis no Vercel Blob. Sem o token, os arquivos ficam no próprio MySQL (até 4 MB cada).
# BLOB_READ_WRITE_TOKEN=""

# Áudio e vídeo dos canais de voz (LiveKit Cloud ou servidor próprio). Sem isso, só o estado de voz funciona.
# LIVEKIT_URL="wss://seu-projeto.livekit.cloud"
# LIVEKIT_API_KEY=""
# LIVEKIT_API_SECRET=""

# Escala: com Redis, eventos chegam na hora e o banco é consultado bem menos (ex.: Upstash, Railway Redis).
# REDIS_URL="redis://default:senha@host:6379"

# Opcional: ajuste fino do gateway (SSE)
# GATEWAY_POLL_MS=1000            intervalo de leitura da fila de eventos sem Redis
# GATEWAY_POLL_WITH_BUS_MS=5000   intervalo de segurança quando o Redis está ligado
# GATEWAY_MAX_LIFETIME_MS=240000  depois disso manda RECONNECT e o cliente retoma (limite de função da Vercel)
