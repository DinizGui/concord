# Banco MySQL (Prisma). Crie o banco vazio e rode: npm run db:push
DATABASE_URL="mysql://usuario:senha@host:3306/concord"

# Protege /api/v1/internal/maintenance (cron da Vercel manda "Authorization: Bearer <valor>")
CRON_SECRET=""

# Opcional: ajuste fino do gateway (SSE)
# GATEWAY_POLL_MS=1000            intervalo de leitura da fila de eventos
# GATEWAY_MAX_LIFETIME_MS=240000  depois disso manda RECONNECT e o cliente retoma (limite de função da Vercel)
